# Данные никогда не коммитятся: лицензии источников и правило рабочего места.
data/
projects/*/data/
projects/*/artifacts/
projects/*/report/*.html
*.csv
*.parquet

# Непереносимая часть журнала: конкретика рабочего места.
knowledge/local/

# Трекинг экспериментов — локальный, в git не попадает.
mlruns/
mlartifacts/

# След прерванного прогона мутации: рабочее состояние, не результат.
.threshold-mutation-active

# Окружение и кэши
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.DS_Store

# Секреты: ни при каких обстоятельствах.
.env
.env.*
*.pem
*.key
kaggle.json
credentials.json
secrets.yaml

# Данные в других форматах — тот же запрет, что и для CSV/Parquet.
*.tsv
*.feather
*.arrow
*.sqlite
*.db
*.xlsx
data/**/*.json

# Отчёты и ноутбуки содержат данные не хуже таблиц.
*.ipynb
projects/*/report/*.pdf
